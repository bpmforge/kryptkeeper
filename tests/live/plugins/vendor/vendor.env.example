# W32-06 vendor-VM run. Copy to vendor.env (gitignored by name pattern *.env is
# NOT assumed: keep it OUTSIDE the repo or never `git add` it), fill in, then:
#   set -a; . ./vendor.env; set +a; bash tests/live/plugins/vendor/run.sh --vendor f5
# Placeholders only. Never commit real credentials, licence keys or serials.

# Management API of the appliance, reachable from the podman hub container.
VENDOR_BASE_URL=https://bigip-ve.lab.example:443
VENDOR_USER=kk-svc
# FILE containing the password (chmod 600). Read at run time; never echoed or logged.
VENDOR_PASS_FILE=/path/outside/repo/vendor.pass
# PEM CA that signs the appliance management certificate (verification stays ON).
VENDOR_TLS_CA_FILE=/path/outside/repo/vendor-mgmt-ca.pem

# host:port of the data-plane VIP/listener that serves the target profile's
# certificate; the hub's post-install verify dials it.
VENDOR_VERIFY_HOST_PORT=vip.lab.example:443
# CN/SAN of the certificate the run issues (should match the VIP name).
VENDOR_CERT_CN=vip.lab.example

# Vendor specific target field (manifest target_schema):
F5_CLIENT_SSL_PROFILE=kk_clientssl_a
CITRIX_CERTKEY_NAME=kk_certkey_a

# Rollback leg: a SECOND profile / certkey that is NOT bound to the VIP above.
# The hub pushes to it but verifies against VENDOR_VERIFY_HOST_PORT, which keeps
# serving the previous certificate, so verify mismatches and the hub must roll
# back. Leave unset to record the rollback leg as PENDING-RUN.
F5_MISMATCH_CLIENT_SSL_PROFILE=kk_clientssl_b
CITRIX_MISMATCH_CERTKEY_NAME=kk_certkey_b
