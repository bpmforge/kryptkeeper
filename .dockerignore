# VCS and local tooling
.git
.github
.claude

# Documentation and planning artifacts. openapi.yaml stays: the dashboard
# image's prebuild step (openapi-typescript) reads it.
docs/*
!docs/openapi.yaml
!docs/embed.go

# Common local/build artifacts
bin
dist
tmp
out
coverage

# Frontend artifacts
node_modules
**/node_modules
ui/dist
web/node_modules
web/dist
web/.next

# Editor/OS noise
.DS_Store
.idea
.vscode

# Secrets and env files
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks

# Keep container build inputs
!Dockerfile
!.dockerignore
