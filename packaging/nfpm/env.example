# /etc/kryptkeeper/env -- systemd EnvironmentFile for the kryptkeeper.service
# unit. Copied here once by postinstall.sh on first install; postinstall
# never overwrites it again, so edits survive upgrades.
#
# See docs/deployment.md ("Bare Metal") in the source repo for the full
# variable reference.

AUTH_MODE=bootstrap
APP_BOOTSTRAP_TOKEN=
APP_BIND_ADDR=0.0.0.0
PORT=8080
KRYPTKEEPER_DB_MODE=sqlite
KRYPTKEEPER_KEYSTORE_DIR=/var/lib/kryptkeeper/keys
KRYPTKEEPER_KEYSTORE_PASSPHRASE=
