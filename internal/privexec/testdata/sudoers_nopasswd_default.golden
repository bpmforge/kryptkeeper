# Kryptkeeper privilege for kryptkeeper-agent (mode nopasswd)
# Install as /etc/sudoers.d/kryptkeeper-agent, chmod 0440, then: visudo -cf <file>
# WARNING: cat/find/install on globbed paths is effectively root read/write of the
# filesystem for anyone holding this account's SSH key ('*' in an argument also matches '/').
# Prefer helper mode unless policy forbids installing the helper.
Defaults:kryptkeeper-agent !requiretty
Cmnd_Alias KK_LIST    = /usr/bin/find /etc/nginx/ssl *, /usr/bin/find /etc/apache2/ssl *
Cmnd_Alias KK_STAT    = /usr/bin/stat -c * /etc/nginx/ssl/*, /usr/bin/stat -c * /etc/apache2/ssl/*
Cmnd_Alias KK_READ    = /usr/bin/cat /etc/nginx/ssl/*, /usr/bin/cat /etc/apache2/ssl/*
Cmnd_Alias KK_INSTALL = /usr/bin/install -m * /etc/nginx/ssl/*, /usr/bin/install -m * /etc/apache2/ssl/*
Cmnd_Alias KK_LISTEN  = /usr/bin/ss -ltnp, /usr/sbin/ss -ltnp
Cmnd_Alias KK_SERVER  = /usr/sbin/nginx -t, /usr/bin/systemctl reload nginx, /usr/sbin/apachectl configtest, /usr/bin/apachectl configtest, /usr/bin/systemctl reload apache2, /usr/bin/systemctl reload httpd
kryptkeeper-agent ALL=(root) NOPASSWD: KK_LIST, KK_STAT, KK_READ, KK_INSTALL, KK_LISTEN, KK_SERVER
