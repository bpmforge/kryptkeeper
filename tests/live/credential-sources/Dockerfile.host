# W38-07: a plain SSH host for the credential-sources harness. sshd takes keys
# only for kkscan, and /etc/nginx/ssl/web.crt is a certificate agentless
# discovery finds in a default scan path. The key pair that logs in is
# generated by run.sh and arrives as /tmp/authorized_keys; nothing secret is
# baked in. nginx itself is not needed: discovery reads the file.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server openssl iproute2 procps curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /etc/nginx/ssl \
    && useradd -m -s /bin/bash kkscan && usermod -p '*' kkscan \
    && mkdir -p /home/kkscan/.ssh && chmod 700 /home/kkscan/.ssh && chown kkscan:kkscan /home/kkscan/.ssh \
    && printf 'PermitRootLogin no\nPasswordAuthentication no\nKbdInteractiveAuthentication no\nAllowUsers kkscan\n' > /etc/ssh/sshd_config.d/10-kk.conf \
    && openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
        -keyout /etc/nginx/ssl/web.key -out /etc/nginx/ssl/web.crt -subj "/CN=web1.kk-credsrc.local" \
    && chmod 600 /etc/nginx/ssl/web.key && chmod 644 /etc/nginx/ssl/web.crt
COPY <<'EOS' /entrypoint.sh
#!/bin/sh
set -e
tries=0
while [ ! -f /tmp/authorized_keys ] && [ $tries -lt 60 ]; do tries=$((tries+1)); sleep 1; done
install -o kkscan -g kkscan -m 600 /tmp/authorized_keys /home/kkscan/.ssh/authorized_keys
ssh-keygen -A >/dev/null
exec /usr/sbin/sshd -D -e
EOS
RUN chmod 755 /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
