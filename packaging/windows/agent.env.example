# Kryptkeeper agent settings for the Windows service. Copy to
# C:\ProgramData\Kryptkeeper\agent.env, edit, then: Restart-Service KryptkeeperAgent
# KEY=VALUE per line. After first registration the agent appends
# KRYPTKEEPER_AGENT_ID / KRYPTKEEPER_AGENT_TOKEN here: restrict this file's ACL
# to SYSTEM and Administrators (see docs/ops/WINDOWS_AGENT.md).
KRYPTKEEPER_HUB_URL=https://hub.example.com:8443
# Enrollment secret: one of the hub's KRYPTKEEPER_AGENT_ENROLLMENT_SECRETS.
# The hub refuses self-registration without it (enrollment is closed by default).
KRYPTKEEPER_AGENT_ENROLLMENT_SECRET=
# KRYPTKEEPER_HUB_CA_CERT_FILE=C:\ProgramData\Kryptkeeper\hub-ca.pem
# KRYPTKEEPER_AGENT_NAME=
# KRYPTKEEPER_POLL_INTERVAL=300
