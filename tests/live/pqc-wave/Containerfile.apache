# Live PQC wave harness (apache leg): Apache httpd (alpine apache2 + mod_ssl) + sshd endpoint. alpine:3.22
# ships OpenSSL 3.5, which httpd links; run-apache-k8s.sh asserts that at run time.
# Also the OpenSSL 3.5 workload image for the kind leg (s_server).
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache apache2 apache2-ssl openssh openssl \
    && mkdir -p /etc/ssl/kk /run/apache2 /root/.ssh \
    && chmod 700 /root/.ssh \
    && openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
         -keyout /etc/ssl/kk/server.key -out /etc/ssl/kk/server.crt -subj "/CN=placeholder.kk-uat.local" \
    && chmod 644 /etc/ssl/kk/server.crt && chmod 600 /etc/ssl/kk/server.key \
    && sed -i -e 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' \
              -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && rm -f /etc/apache2/conf.d/ssl.conf /etc/apache2/conf.d/default.conf
COPY apache-kk.conf /etc/apache2/conf.d/kk.conf
COPY entrypoint-apache.sh /entrypoint.sh
# A container has no systemd. The installer reloads with `systemctl reload apache2`.
COPY systemctl-shim-apache.sh /usr/local/bin/systemctl
COPY apachectl-shim.sh /usr/sbin/apachectl
RUN chmod +x /entrypoint.sh /usr/local/bin/systemctl /usr/sbin/apachectl
EXPOSE 22 443
ENTRYPOINT ["/entrypoint.sh"]
