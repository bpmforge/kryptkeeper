class Kryptkeeper < Formula
  desc "Self-hosted machine-identity / certificate-lifecycle platform (PKI hub)"
  homepage "https://github.com/bpmforge/kryptkeeper"
  version "__VERSION__"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/bpmforge/kryptkeeper/releases/download/__TAG__/kryptkeeper-darwin-arm64"
      sha256 "__SHA256_DARWIN_ARM64__"
    else
      url "https://github.com/bpmforge/kryptkeeper/releases/download/__TAG__/kryptkeeper-darwin-amd64"
      sha256 "__SHA256_DARWIN_AMD64__"
    end
  end

  def install
    asset = Dir["kryptkeeper-darwin-*"].first
    odie "expected asset kryptkeeper-darwin-{amd64,arm64} not found in download" unless asset
    bin.install asset => "kryptkeeper"
  end

  test do
    assert_predicate bin/"kryptkeeper", :exist?
    assert_predicate bin/"kryptkeeper", :executable?
  end
end
